---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2 class="psycode"><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog" showDot>Blog</HeaderLink>
			<HeaderLink href="/about" showDot>Apps</HeaderLink>
		</div>
		<div class="social-links">
			<label for="dark-mode">
				<div class="switch">
					<input id="dark-mode" checked type="checkbox">
	
					<div class="insetcover">
					<div class="sun-moon sun"></div>
					<div class="sun-moon moon"></div>
					<div class="stars"></div>
					</div>
	
					<div class="sun-moon-shadow"></div>
					<div class="shadow-overlay"></div>
				</div>
			</label>
		</div>
	</nav>
	<script>
 	const button = document.querySelector("#dark-mode");

	button?.addEventListener("click", () => {
		if(document.body.classList.contains("dark")){
			document.body.classList.remove("dark");
		}else{
			document.body.classList.add("dark");
		}
	});
</script>
</header>
<style>
	header {
		margin: 0;
		padding: .1em 1em;
		background: var(--light-transparency);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		left: 0;
		right: 0;
		position: relative;
		z-index: 1;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.8em;
		color: var(--navbar-links);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent-dark);
		color: #0A66C2;
	}
	.social-links{
		display: flex;
	}
	@media (max-width: 720px) {
		.internal-links {
			font-size: .9em;
		}
		nav{
			height: 8vh;
		}
		.psycode{
		display: none;
	}
	}
</style>
