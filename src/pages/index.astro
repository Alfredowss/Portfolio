---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import myPhoto from "../assets/alfred.png";
import BoogApp from "../assets/BoogApp.png";
import ExactScience from "../assets/exact-science.png";
import AnacondaSw from "../assets/anaconda.png";
import Inter from "../assets/inter.png";
import PostPreview from "../components/home/PostPreview.astro"
import Hero from "../components/home/Hero.astro"
import MusicMenu from '../components/common/MusicMenu.astro';
import InfiniteSlider from '../components/common/InfiniteSlider.astro';
import Angular from "../assets/angular.png";
import Java from "../assets/java.png";
import React from "../assets/react.png";
import Node from "../assets/node.png";

const experienceUrls = [
	{src: BoogApp, size: "w-[80px] xl:w-[140px]", margin: "mx-6"}, 
	{src: ExactScience, size: "w-[180px] xl:w-[280px]", margin: "mx-6"}, 
	{src: Inter, size: "w-[200px] xl:w-[320px]" , margin: "mx-6"}, 
	{src: ExactScience, size: "w-[180px] xl:w-[280px]" , margin: "mx-6"},
	{src: AnacondaSw, size: "w-[100px] xl:w-[160px]",  margin: "mx-6"},
	{src: BoogApp, size: "w-[80px] xl:w-[140px]", margin: "mx-6"}, 
	{src: ExactScience, size: "w-[180px] xl:w-[280px]", margin: "mx-6"}, 
	{src: Inter, size: "w-[200px] xl:w-[320px]" , margin: "mx-6"}, 
	{src: ExactScience, size: "w-[180px] xl:w-[280px]" , margin: "mx-6"},
	{src: AnacondaSw, size: "w-[100px] xl:w-[160px]",  margin: "mx-6"}
]

const stackUrls = [
	{src: Angular, size: "w-[60px] xl:w-[100px]", margin: "mx-6 xl:mx-12"}, 
	{src: React, size: "w-[140px] xl:w-[240px]", margin: "mx-6 xl:mx-12"}, 
	{src: Java, size: "w-[130px] xl:w-[190px]", margin: "mx-6 xl:mx-12"}, 
	{src: Node, size: "w-[60px] xl:w-[80px]", margin: "mx-6 xl:mx-12"},
	{src: React, size: "w-[140px] xl:w-[240px]", margin: "mx-6 xl:mx-12"},
	{src: Angular, size: "w-[60px] xl:w-[100px]", margin: "mx-6 xl:mx-12"}, 
	{src: React, size: "w-[140px] xl:w-[240px]", margin: "mx-6 xl:mx-12"}, 
	{src: Java, size: "w-[130px] xl:w-[190px]", margin: "mx-6 xl:mx-12"}, 
	{src: Node, size: "w-[60px] xl:w-[80px]", margin: "mx-6 xl:mx-12"},
	{src: React, size: "w-[140px] xl:w-[240px]", margin: "mx-6 xl:mx-12"}
]
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body class="hero dark">
	
		<MusicMenu />
		
		<Hero/>

		<section class="relative z-3 slider hero-2">
			<InfiniteSlider 
				urls={experienceUrls}
				title={"Experience"}
			/>
			<PostPreview />
			<InfiniteSlider 
				urls={stackUrls}
				title={"MainStack"}
			/>
		</section>

		<section class="hero-2 h-svh pt-20">
			<h6 class="ps-[14vw]">Fetured works</h6>
		</section>		
	</body>
	<style>
		.dark .hero-2 {
			position: relative;
			background: 
			linear-gradient(
				140deg,
				#030c13 -38%,
				#030c17 30%,
				#030c17 50%,
				#030c17 60%,
				#030c13 86%
			);
			mix-blend-mode: daken; 
			background-size: cover;
			background-position: top center;
			background-repeat: no-repeat;
		}

		.hero-2 {
			background: linear-gradient(
				140deg,
				#2c88f1 -38%,
				#e8e8e8 30%,
				#e8e8e8 50%,
				#e8e8e8 60%,
				#9bcbff 86%
			);
		}
</style>
	<script>
		import interact from 'interactjs';

		let didDrag = false;
		let isDragging = false;

		const pill = document.getElementById('floating-pill');
		const trigger = document.getElementById('pill-trigger');
		const bottomCta = document.getElementById('bottom-cta');

		let x = window.innerWidth * 0.22;
		let y = window.innerHeight * 0.18;
		pill.style.transform = `translate(${x}px, ${y}px)`;
		pill.setAttribute('data-x', x);
		pill.setAttribute('data-y', y);
		pill.style.opacity = '1';

		function isOverTarget() {
		const pillRect = pill.getBoundingClientRect();
		const ctaRect = bottomCta.getBoundingClientRect();

		const pillCX = pillRect.left + pillRect.width / 2;
		const pillCY = pillRect.top + pillRect.height / 2;

		return (
			pillCX >= ctaRect.left &&
			pillCX <= ctaRect.right &&
			pillCY >= ctaRect.top &&
			pillCY <= ctaRect.bottom
		);
		}

		function showBottomCta() {
		pill.classList.add('pill-hidden');
		bottomCta.classList.add('visible');
		}

		function hideBottomCta() {
		pill.classList.remove('pill-hidden');
		bottomCta.classList.remove('visible');
		bottomCta.classList.remove('over');
		}

		interact('.floating-pill').draggable({
		listeners: {
			start() {
			didDrag = false;
			isDragging = true;
			showBottomCta();
			},
			move(event) {
			didDrag = true;
			const target = event.target;

			x = (parseFloat(target.getAttribute('data-x')) || 0) + event.dx;
			y = (parseFloat(target.getAttribute('data-y')) || 0) + event.dy;

			x = Math.max(0, Math.min(window.innerWidth - target.offsetWidth, x));
			y = Math.max(0, Math.min(window.innerHeight - target.offsetHeight, y));

			target.style.transform = `translate(${x}px, ${y}px)`;
			target.setAttribute('data-x', x);
			target.setAttribute('data-y', y);

			// Highlight the X button when pill hovers over it
			if (isOverTarget()) {
				bottomCta.classList.add('over');
			} else {
				bottomCta.classList.remove('over');
			}
			},
			end() {
			isDragging = false;

			if (isOverTarget()) {
				// Matched — dismiss pill and hide X button
				pill.classList.add('pill-dismissed');
				bottomCta.classList.remove('visible');
				bottomCta.classList.remove('over');
			} else {
				hideBottomCta();
			}
			}
		},
		inertia: true
		});

		trigger.addEventListener('click', () => {
		if (didDrag) {
			didDrag = false;
			return;
		}
		pill.classList.toggle('open');
		});

		document.addEventListener('click', (e) => {
		if (!pill.contains(e.target)) pill.classList.remove('open');
		});
	</script>
</html>