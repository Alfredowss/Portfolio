---
import Header from '../../components/Header.astro';
import { Image } from 'astro:assets';
import verified from "../../assets/verified.svg";
import Abstract from "../../assets/abstract.png";
---

<main class="h-svh grid grid-rows-[auto_1fr]"> 
            <svg
                xmlns="//www.w3.org/2000/svg"
                version="1.1"
                class="svg-filters"
                style="display: none;"
                >
                    <defs>
                        <filter id="marker-shape">
                            <feTurbulence
                                type="fractalNoise"
                                baseFrequency="0 0.15"
                                numOctaves="1"
                                result="warp"
                            />
                            <feDisplacementMap
                                xChannelSelector="R"
                                yChannelSelector="G"
                                scale="30"
                                in="SourceGraphic"
                                in2="warp"
                            />
                    </filter>
                </defs>
            </svg>
			<Header />
			<article class="pt-[4svh] md:py-0 grid grid-rows-[auto_2fr] grid-cols-1 md:grid-rows-1 md:grid-cols-[auto_auto] gap-x-10 justify-items-end content-stretch  md:px-16">  	
				<div class="lines">
					<div class="line"></div>
					<div class="line"></div>
					<div class="line"></div>
					<div class="line"></div>
				</div>
				<section class="md:h-auto h-full row-start-2 md:row-start-auto w-[98vw] md:w-auto max-w-[800px] grid grid-rows-[1fr_auto_1fr] md:grid-rows-[auto_auto_auto] content-center md:gap-y-5 relative z-2">
					<h1 class="font-[500] flex items-center justify-around md:justify-start relative py-4 pt-6 md:py-0 text-center">
						<span class="leading-11 md:leading-none hero-brand relative">
							Hi, I'm <span class="text-[#0A66C2]">Alfredo<Image class="inline mx-3 pb-1 lg:mx-4" src={ verified }alt="verified bafge"/></span><br/>
							<span class="highlight text-white">Software Engineer</span>
						</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="hero-svg" style="display:none">
							<filter id="marker-shape">
								<feTurbulence 
								type="fractalNoise"
								baseFrequency="0 0.15"
								numOctaves="1"
								result="warp"
								/>
								<feDisplacementMap 
								in="SourceGraphic"
								in2="warp"
								scale="6"
								/>
							</filter>
						</svg>				
					</h1>	
					<p class="flex items-center px-7 md:px-0 md:block m-0 text-base md:text-xl text-center md:text-left"> I help business to ship, create, mantain, and extend his operations, specialized on scalable frontend arquitechtures, i have experience providing solutions with multiple frontend and backend tecnhologies such as React, Angular and Java</p>
					<div class="draggable flex items-center justify-center md:justify-start">
						<div class="w-[46%]">
							<button id="sliderRail" class="cssbuttons-io-button text-center">
								  Apps
								<div class="icon">
									<svg
									height="24"
									width="24"
									viewBox="0 0 24 24"
									xmlns="http://www.w3.org/2000/svg"
									>
									<path d="M0 0h24v24H0z" fill="none"></path>
									<path
										d="M16.172 11l-5.364-5.364 1.414-1.414L20 12l-7.778 7.778-1.414-1.414L16.172 13H4v-2z"
										fill="#bababa"
									></path>
									</svg>
								</div>
							</button>
						</div>
					<div>	
				</section>	
				<section class="row-start-1 row-end-2 md:row-start-auto md:row-end-auto relative justify-self-center md:justify-self-start content-center relative">
					<figure class="rounded-full text-light relative z-2 md:top-[-1em] w-[53vw] h-[53vw] md:w-[360px] md:h-[360px] xl:w-[400px] xl:h-[400px]" style="overflow:hidden; display: flex; justify-content:center; align-items: center;">
						<figure class="w-[53vw] h-[53vw] xl:w-[400px] xl:h-[400px] user-photo" style="z-index:2"/>
					</figure>
					<figure class="abstract-background">

					</figure>
				</section>
		</article>
</main>

<style is:global>
	.text-base{
		font-size: .86em;
	}
	.abstract-background{
 		 background-image: url("/public/abstract.png");
		 width: 82vw;
		 height: 82vw;
		 background-size: contain;
		 background-repeat: no-repeat;
		 position: absolute;
		 top: -19%;
		 left: -22%;
	}
	.dark .abstract-background{
		 background-image: url("/public/abstract-light.png");
		 width: 86vw;
		 height: 86vw;
		 background-size: contain;
		 background-repeat: no-repeat;
		 position: absolute;
		 top: -34%;
		 left: -20%;
	}

	@media (min-width: 1200px) {
		.dark .abstract-background{
		 width: 36vw !important;
		 height: 36vw !important;
		 background-size: contain;
		 background-repeat: no-repeat;
		 position: absolute;
		 top: 6%;
		 left: -22s%;
	}
	}
</style>