<style>
    .floating-pill {
		position: fixed;
		top: -28px;
		left: 10px;
		z-index: 9999;
		touch-action: none;
		display: flex;
		align-items: center;
		border-radius: 999px;
		box-shadow:
			0 6px 16px rgba(0, 0, 0, 0.25),
			0 2px 6px rgba(0, 0, 0, 0.15);
		background-color: #28224246;	
		overflow: hidden;
		width: 50px;
		height: 48px;
		transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
	}

	.floating-pill.open {
		width: 210px;
	}

	.floating-pill.pill-hidden {
		opacity: 0;
		pointer-events: none;
	}

	.floating-pill.pill-dismissed {
		display: none;
	}

	.pill-trigger {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		cursor: pointer;
		padding: 3px;
	}

	.pill-trigger svg {
		width: 42px;
		height: 42px;
	}

	.pill-menu {
		display: flex;
		align-items: center;
		gap: 4px;
		padding-right: 10px;
		opacity: 0;
		transition: opacity 0.2s ease 0s;
	}

	.floating-pill.open .pill-menu {
		opacity: 1;
		transition: opacity 0.2s ease 0.2s;
	}

	.pill-item {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		color: #fff;
		transition: background 0.15s ease;
	}

	.pill-item:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.pill-item svg {
		width: 18px;
		height: 18px;
		fill: #fff;
	}

	.bottom-cta {
		position: fixed;
		bottom: 32px;
		left: 50%;
		transform: translateX(-50%) scale(1);
		z-index: 9999;
		background: #3d3d3d;
		color: #fff;
		font-size: 20px;
		line-height: 1;
		border: none;
		border-radius: 999px;
		width: 50px;
		height: 50px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease, background 0.15s ease;
	}

	.bottom-cta.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.bottom-cta.over {
		background: #e53e3e;
		transform: translateX(-50%) scale(1.15);
	}

	.spinner-ring {
  position: absolute;
  top: 50%;
  left: 24px;
  transform: translate(-50%, -50%);
  width: 54px;
  height: 54px;
  pointer-events: none;
  z-index: 2;
}

.spinner-ring svg {
  width: 100%;
  height: 100%;
  animation: spin 1.6s linear infinite;
  transform-origin: center;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.spinner-arc {
  fill: none;
  stroke: #1ed72a;
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-dasharray: 38 62;
  stroke-dashoffset: 0;
}
</style>