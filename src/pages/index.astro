---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import myPhoto from "../assets/alfred.jpeg";
import BoogApp from "../assets/BoogApp.png";
import ExactScience from "../assets/exact-science.png";
import AnacondaSw from "../assets/anaconda.png";
import Inter from "../assets/inter.png";
import verified from "../assets/verified.svg";

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body class="hero dark">
		<svg
	xmlns="//www.w3.org/2000/svg"
	version="1.1"
	class="svg-filters"
	style="display: none;"
	>
	<defs>
		<filter id="marker-shape">
		<feTurbulence
			type="fractalNoise"
			baseFrequency="0 0.15"
			numOctaves="1"
			result="warp"
		/>
		<feDisplacementMap
			xChannelSelector="R"
			yChannelSelector="G"
			scale="30"
			in="SourceGraphic"
			in2="warp"
		/>
		</filter>
	</defs>
		</svg>
		<main class="h-svh text-center md:text-left grid grid-rows-[auto_1fr]"> 
			<Header />
			<article class="py-[5svh] md:py-0 grid grid-rows-[1fr_2fr] grid-cols-1 md:grid-rows-1 md:grid-cols-[auto_auto] gap-x-10 justify-items-end content-stretch  md:px-16">  	
			<div class="lines">
  				<div class="line"></div>
  				<div class="line"></div>
  				<div class="line"></div>
  				<div class="line"></div>
			</div>
				<section class="md:h-auto row-start-2 md:row-start-auto max-w-[800px] grid grid-rows-[1fr_1fr_1fr] md:grid-rows-[auto_auto_auto] content-center md:gap-y-5 relative z-2">
					<h1 class="font-[500] flex items-center justify-around md:justify-start relative">
					<span class="leading-11 md:leading-none hero-brand">
						Hi, I'm <span class="text-[#0A66C2]">Alfredo<Image class="inline mx-3 pb-1 lg:mx-4" src={ verified }alt="verified bafge"/></span><br/>
						<span class="highlight text-white">Software Engineer</span>
					</span>
					</h1>	
					<svg xmlns="http://www.w3.org/2000/svg" class="hero-svg" style="display:none">
						<filter id="marker-shape">
							<feTurbulence 
							type="fractalNoise"
							baseFrequency="0 0.15"
							numOctaves="1"
							result="warp"
							/>
							<feDisplacementMap 
							in="SourceGraphic"
							in2="warp"
							scale="6"
							/>
						</filter>
					</svg>				
					<p class="flex items-center px-7 md:px-0 md:block m-0 text-base md:text-xl"> Specialized on create, mantain and extend scalable frontend arquitechtures, i have experience providing solutions with multiple frontend and backend tecnhologies such as React, Angular and Java</p>
					<div class="draggable flex items-center justify-center md:justify-start">
						<div class="w-[46%]">
							<button id="sliderRail" class="cssbuttons-io-button text-center">
								  Blog
								<div class="icon">
									<svg
									height="24"
									width="24"
									viewBox="0 0 24 24"
									xmlns="http://www.w3.org/2000/svg"
									>
									<path d="M0 0h24v24H0z" fill="none"></path>
									<path
										d="M16.172 11l-5.364-5.364 1.414-1.414L20 12l-7.778 7.778-1.414-1.414L16.172 13H4v-2z"
										fill="#bababa"
									></path>
									</svg>
								</div>
							</button>
						</div>
					<div>	
				</section>	

				<section class="row-start-1 row-end-2 md:row-start-auto md:row-end-auto relative justify-self-center md:justify-self-start content-center">
					<figure class="rounded-full text-light relative z-2 md:top-[-1em] w-[52vw] h-[52vw] md:w-[360px] md:h-[360px] xl:w-[400px] xl:h-[400px]" style="overflow:hidden; display: flex; justify-content:center; align-items: center;">
						<Image class="w-[52vw] h-[52vw] xl:w-[400px] xl:h-[400px] user-photo"
						       src={ myPhoto } alt="user image" />
							</figure>
				</section>
			</article>
		</main>
		<section class="h-[100vh] relative z-3 slider hero-2">
			<section class="flex items-center slide-track">
				<Image class="w-[98px] md:w-[160px] mx-8 slide"
				    src={ AnacondaSw } alt="user image" />
				<Image class="w-[98px] md:w-[140px] mx-8 slide"
				    width={400} 
				    height={100} 
				    src={ BoogApp } alt="user image" />
				<Image class="w-[166px] md:w-[260px] mx-6 slide"
			        width={400} 
				    height={100} 
				    src={ ExactScience } alt="user image" />
				<Image class="w-[160px] md:w-[320px] mx-6 slide"
				    src={ Inter } alt="user image" />
				<Image class="w-[98px] md:w-[160px] slide mx-8"
				    src={ AnacondaSw } alt="user image" />
				<Image class="w-[166px] md:w-[260px] mx-6 slide"
			        width={400} 
				    height={100} 
				    src={ ExactScience } alt="user image" />
				<Image class="w-[98px] md:w-[140px] mx-8"
				    width={400} 
				    height={100} 
				    src={ BoogApp } alt="user image" />
				<Image class="w-[166px] md:w-[260px] mx-6 slide"
			        width={400} 
				    height={100} 
				    src={ ExactScience } alt="user image" />
				<Image class="w-[160px] md:w-[320px] mx-6 slide"
				    src={ Inter } alt="user image" />
			</section>
			<section class="h-[100vh] hero-3">
				<h5>My Projects</h5>
				<div>One</div>
				<div>Two</div>
				<div>Three</div>
				
			</section>
		</section>	
	</body>
	<style>
		.dark .slide-track {
			background-color: gray;
		}

		.dark .hero-2{
			 position: relative;
			background: 
			linear-gradient(
				140deg,
				#030c13 -38%,
				#040d1a 30%,
				#040d1a 50%,
				#040d1a 60%,
				#030c13 86%
			);
			
			mix-blend-mode: daken; 
			background-size: cover;
			background-position: top center;
			background-repeat: no-repeat;
		}

		.hero-2{
			background: linear-gradient(
				140deg,
				#2c88f1 -38%,
				#e8e8e8 30%,
				#e8e8e8 50%,
				#e8e8e8 60%,
				#9bcbff 86%
			);
		}

	</style>
</html>
